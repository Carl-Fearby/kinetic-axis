CONTACT_PORT=4319
PUBLIC_SITE_URL=https://kineticaxisdigital.com

# Production sender/recipient values. The live .env remains server-side and is never packaged.
SMTP_FROM=Kinetic Axis <carl@kineticaxisdigital.co.uk>
CONTACT_TO=carl@kineticaxisdigital.co.uk

# Optional override for first-party, anonymous conversion event storage.
ANALYTICS_LOG_PATH=/var/lib/kineticaxis/analytics/events.ndjson

# Optional paths for non-PII lead attribution and the protected growth dashboard.
LEADS_LOG_PATH=/var/lib/kineticaxis/analytics/leads.ndjson
# Generate a long random value on the server; never commit the live value.

# Private lead pipeline. Contains enquiry contact details, notes and follow-up state.
# Keep this server-side and outside the static web root.
LEAD_PIPELINE_LOG_PATH=/var/lib/kineticaxis/leads/activity.ndjson
